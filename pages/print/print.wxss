.print-page {
  padding-top: 24rpx;
}

.stage {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 0;
}

.sheet {
  display: block;
  border-radius: 4rpx;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.62);
  background: #ffffff;
}

.stage-meta {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 20rpx;
}

.stage-name {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--text);
}

.stage-sep {
  margin: 0 10rpx;
  color: var(--text-3);
}

.stage-info {
  font-size: 24rpx;
  color: var(--text-2);
}

.tags {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  margin-top: 14rpx;
}

.tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--text-2);
}

.tag-ok {
  color: #9fd0bb;
  border-color: rgba(127, 185, 168, 0.4);
  background: rgba(127, 185, 168, 0.1);
}

.tag-warn {
  color: #e0b47a;
  border-color: rgba(224, 180, 122, 0.4);
  background: rgba(224, 180, 122, 0.1);
}

.warn {
  margin: 20rpx 0 0;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #e0b47a;
  border-radius: 12rpx;
  background: rgba(224, 180, 122, 0.1);
}

.group {
  margin-top: 36rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.group-title {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--text-2);
}

.group-note {
  font-size: 21rpx;
  color: var(--text-3);
}

.opts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 6rpx;
  border-radius: 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.opt-name {
  font-size: 26rpx;
  color: var(--text);
}

.opt-note {
  font-size: 19rpx;
  color: var(--text-3);
}

.opt-on {
  border-color: rgba(217, 192, 140, 0.55);
  background: var(--accent-soft);
}

.opt-on .opt-name {
  color: var(--accent);
}

.opt-off {
  opacity: 0.38;
}

.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.seg-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-2);
  border-radius: 10rpx;
}

.seg-4 .seg-item {
  font-size: 22rpx;
}

.seg-item-on {
  color: #14151a;
  background: var(--accent);
  font-weight: 500;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.switch-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.switch-label {
  font-size: 26rpx;
  color: var(--text);
}

.switch-note {
  font-size: 21rpx;
  color: var(--text-3);
}

.tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--jade);
  flex: none;
}

.btn-primary {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #14151a;
  background: var(--accent);
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
  color: #14151a;
  background: var(--accent);
}

.out {
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.out-img {
  display: block;
  width: 100%;
  border-radius: 8rpx;
  background: #ffffff;
}

.out-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.out-info {
  font-size: 23rpx;
  color: var(--text-2);
}

.out-hint {
  font-size: 21rpx;
  color: var(--text-3);
}

.out-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  color: var(--text);
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
}

.btn-ghost::after {
  border: none;
}

.out-note {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--text-3);
}
