.preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 40rpx;
}

.preview {
  display: block;
  border-radius: 10rpx;
  box-shadow: 0 10rpx 32rpx rgba(42, 39, 36, 0.14);
}

.preview-tag {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #a29a8d;
  letter-spacing: 1rpx;
}

.form {
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.field {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field-last {
  border-bottom: none;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

.counter {
  font-size: 21rpx;
  color: #b3ab9e;
}

.counter-over {
  color: #c0392b;
}

.toggle {
  font-size: 23rpx;
  color: var(--accent);
  padding: 4rpx 8rpx;
}

.input {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.5;
}

.ph {
  color: #c4bcae;
}

.seg {
  display: flex;
  margin-top: 16rpx;
  padding: 6rpx;
  background: #f3efe7;
  border-radius: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  line-height: 62rpx;
  color: var(--ink-soft);
  border-radius: 8rpx;
}

.seg-item-on {
  background: #ffffff;
  color: var(--ink);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(42, 39, 36, 0.08);
}

.warn {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fdf6e6;
}

.hint-line {
  margin-top: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a29a8d;
}

.warn-item {
  display: block;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8a6a1f;
}

.status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #a29a8d;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #7fae7f;
}

.payload {
  margin-top: 18rpx;
  padding: 0 8rpx 32rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.6;
  color: #b9b1a4;
}
