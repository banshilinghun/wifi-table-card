.stage {
  /* 高度交给内容：横版卡片不会被 720rpx 的空舞台撑出一大片留白 */
  min-height: 300rpx;
  padding: 40rpx 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  display: block;
  border-radius: 6rpx;
  box-shadow: 0 26rpx 60rpx rgba(0, 0, 0, 0.62);
}

.stage-meta {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 8rpx;
}

.stage-name {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--text);
}

.stage-sep {
  margin: 0 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.stage-print {
  font-size: 23rpx;
  color: var(--accent);
}

.stage-sub {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
  color: var(--text-3);
}

/* ── 表单 ─────────────────────────────────────────────── */

.form {
  margin-top: 40rpx;
  padding: 0 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
}

.field {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field-last {
  border-bottom: none;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: var(--text-3);
}

.counter {
  font-size: 20rpx;
  color: var(--text-3);
}

.counter-over {
  color: #e0785f;
}

.toggle {
  padding: 4rpx 8rpx;
  font-size: 22rpx;
  color: var(--accent);
}

.input {
  margin-top: 12rpx;
  font-size: 31rpx;
  line-height: 1.5;
  color: var(--text);
}

.ph {
  color: #4a4f57;
}

.seg {
  display: flex;
  margin-top: 16rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.045);
  border-radius: 14rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  line-height: 64rpx;
  color: var(--text-2);
  border-radius: 10rpx;
}

.seg-item-on {
  background: var(--text);
  color: #0b0c0e;
  font-weight: 500;
}

.single-print {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.single-print-name {
  font-size: 25rpx;
  color: var(--text);
}

.single-print-note {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ── 提示 ─────────────────────────────────────────────── */

.hint-line {
  margin-top: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-3);
}

.warn {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border-left: 3rpx solid rgba(224, 120, 95, 0.7);
  background: rgba(224, 120, 95, 0.08);
}

.warn-item {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #d8a08f;
}

.status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--jade);
}

.payload {
  margin-top: 16rpx;
  padding: 0 8rpx 40rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.65;
  color: #474c54;
}
