<view class="page">
  <view class="card">
    <view class="head">
      <view class="title">Wi-Fi 二维码</view>
      <view class="badge">EC {{ec}} · 静区 {{quiet}}</view>
    </view>

    <view class="seg">
      <view
        wx:for="{{demos}}"
        wx:key="key"
        class="seg-item {{demo === item.key ? 'seg-item-on' : ''}}"
        data-demo="{{item.key}}"
        bindtap="switchDemo"
      >{{item.label}}</view>
    </view>

    <view class="qr-wrap">
      <canvas
        type="2d"
        id="qrcanvas"
        class="qr-canvas"
        style="width:{{canvasSize}}px;height:{{canvasSize}}px"
      ></canvas>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view class="rows">
      <view class="row">
        <text class="k">SSID</text>
        <text class="v mono">{{ssid}}</text>
      </view>
      <view class="row">
        <text class="k">密码</text>
        <text class="v mono">{{password}}</text>
      </view>
      <view class="row">
        <text class="k">载荷</text>
        <text class="v mono payload">{{payload}}</text>
      </view>
      <view class="row">
        <text class="k">版本</text>
        <text class="v">{{version}} 版 · {{moduleCount}} × {{moduleCount}} 模块</text>
      </view>
      <view class="row">
        <text class="k">画布</text>
        <text class="v">{{canvasSize}} px @ {{dpr}}x</text>
      </view>
    </view>

    <view wx:if="{{warnings.length}}" class="warn">
      <view class="warn-title">校验提示</view>
      <text wx:for="{{warnings}}" wx:key="*this" class="warn-item">· {{item}}</text>
    </view>
  </view>

  <view class="hint">切换示例后二维码立即重绘。用手机相机或微信扫一扫，中文示例应识别为「咖啡店」而不是乱码。</view>
</view>
