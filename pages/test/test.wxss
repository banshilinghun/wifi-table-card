.card {
  padding: 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}

.badge {
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.seg {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.045);
  border-radius: 14rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 64rpx;
  color: var(--text-2);
  border-radius: 10rpx;
}

.seg-item-on {
  background: var(--text);
  color: #0b0c0e;
  font-weight: 500;
}

.qr-wrap {
  margin: 28rpx auto 24rpx;
  width: 560rpx;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.qr-canvas {
  display: block;
}

.rows {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.k {
  flex: 0 0 110rpx;
  color: var(--text-3);
}

.v {
  flex: 1;
  color: var(--text);
}

.payload {
  color: var(--accent);
}

.error {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: rgba(224, 120, 95, 0.12);
  color: #e09a88;
  font-size: 24rpx;
}

.warn {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: rgba(217, 192, 140, 0.09);
}

.warn-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--accent);
}

.warn-item {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #bda97e;
}

.hint {
  margin-top: 32rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--text-3);
}
