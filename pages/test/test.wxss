.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
}

.badge {
  font-size: 22rpx;
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.seg {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  background: #f3efe7;
  border-radius: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 64rpx;
  color: var(--ink-soft);
  border-radius: 8rpx;
}

.seg-item-on {
  background: #ffffff;
  color: var(--ink);
  font-weight: 500;
}

.qr-wrap {
  margin: 28rpx auto 24rpx;
  width: 560rpx;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.qr-canvas {
  display: block;
}

.rows {
  border-top: 1rpx solid var(--line);
  padding-top: 16rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.k {
  flex: 0 0 110rpx;
  color: var(--ink-soft);
}

.v {
  flex: 1;
  color: var(--ink);
}

.payload {
  color: var(--accent);
}

.error {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #fdecea;
  color: #a02c22;
  font-size: 24rpx;
}

.warn {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fdf6e6;
}

.warn-title {
  font-size: 24rpx;
  color: #8a6a1f;
  font-weight: 500;
}

.warn-item {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8a6a1f;
}

.hint {
  margin-top: 32rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #a29a8d;
}
