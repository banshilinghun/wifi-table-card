<view class="root">
  <view class="page">
    <view class="masthead">
      <view class="mast-left">
        <text class="mast-kicker">WIFI SIGN</text>
        <view class="mast-title-row">
          <text class="mast-title">桌牌</text>
          <text class="mast-count" wx:if="{{totalLabel}}">{{totalLabel}}</text>
          <text class="mast-count" wx:else>{{matchCount}} / {{total}}</text>
        </view>
      </view>
      <view class="filter-btn {{activeCount ? 'filter-btn-on' : ''}}" bindtap="openDrawer">
        <view class="ico ico-filter">
          <view class="ico-i a"></view>
          <view class="ico-i b"></view>
          <view class="ico-i c"></view>
        </view>
        <text class="filter-txt">筛选</text>
        <view class="filter-badge" wx:if="{{activeCount}}">{{activeCount}}</view>
      </view>
    </view>

    <scroll-view class="scenes" scroll-x="true" enable-flex="false" show-scrollbar="false">
      <view
        class="scene {{item.on ? 'scene-on' : ''}}"
        wx:for="{{scenes}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickScene"
      >
        <view class="ico ico-{{item.icon}}">
          <view class="ico-i a"></view>
          <view class="ico-i b"></view>
          <view class="ico-i c"></view>
          <view class="ico-i d"></view>
        </view>
        <text class="scene-label">{{item.label}}</text>
      </view>
    </scroll-view>

    <view class="chips-line" wx:if="{{chips.length}}">
      <view
        class="chip chip-sm {{item.kind === 'pref' ? 'chip-pref' : ''}}"
        wx:for="{{chips}}"
        wx:key="key"
        data-dim="{{item.dim}}"
        data-key="{{item.key}}"
        bindtap="toggleChip"
      >
        <text>{{item.label}}</text>
        <text class="chip-x">×</text>
      </view>
      <text class="chips-clear" bindtap="resetFilters">清空</text>
    </view>

    <view class="grid">
      <view
        class="cell"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openEditor"
        hover-class="cell-hover"
        hover-stay-time="60"
      >
        <view class="thumb-box">
          <canvas
            type="2d"
            class="thumb"
            style="width:{{item.thumbW}}rpx;height:{{item.thumbH}}rpx"
          ></canvas>
        </view>
        <view class="cell-meta">
          <text class="cell-name">{{item.name}}</text>
          <text class="cell-shape">{{item.shape}}</text>
        </view>
        <text class="cell-prints">{{item.printsText}} · {{item.region}}</text>
        <text class="cell-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length}}">
      <text class="empty-title">没有符合的模板</text>
      <text class="empty-sub">形状与打印尺寸是过滤条件，两者交叉后没有结果。清掉这两项，场景与偏好会保留。</text>
      <view class="empty-btn" bindtap="clearHardFilters">清除形状/尺寸筛选</view>
      <text class="empty-alt" bindtap="resetFilters">重置全部条件</text>
    </view>

    <view class="more" wx:if="{{loading}}">
      <text class="more-txt">正在排下一批…</text>
    </view>
    <view class="more" wx:elif="{{hasMore && list.length}}">
      <view class="more-btn" bindtap="loadMore">再取 {{pageSize}} 套</view>
    </view>

    <view class="foot">
      <view class="foot-link" bindtap="goTest">二维码内核自检 ›</view>
      <text class="foot-note">全部数据仅存本机 · 无网络请求 · 模板由本地工厂生成 · v{{version}}</text>
    </view>
  </view>

  <view class="mask" wx:if="{{drawer}}" bindtap="closeDrawer" catchtouchmove="noop"></view>

  <view class="drawer {{drawer ? 'drawer-on' : ''}}" catchtouchmove="noop">
    <view class="grip"></view>

    <view class="drawer-head">
      <text class="drawer-title">筛选</text>
      <view class="drawer-close" bindtap="closeDrawer">
        <view class="ico ico-close">
          <view class="ico-i a"></view>
          <view class="ico-i b"></view>
        </view>
      </view>
    </view>

    <scroll-view class="drawer-body" scroll-y="true">
      <view class="group">
        <view class="group-head">
          <text class="group-name">形状</text>
          <text class="tag tag-filter">过滤</text>
        </view>
        <view class="chip-row">
          <view
            class="chip {{item.on ? 'chip-on' : ''}}"
            wx:for="{{shapes}}"
            wx:key="key"
            data-dim="shapes"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="group">
        <view class="group-head">
          <text class="group-name">打印格式</text>
          <text class="tag tag-filter">过滤</text>
        </view>
        <view class="chip-row">
          <view
            class="chip {{item.on ? 'chip-on' : ''}}"
            wx:for="{{printOpts}}"
            wx:key="key"
            data-dim="prints"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
        <text class="group-note">A4 · A5 · 横版 A5 · 长条 200×100 · 竖条 100×200 · 迷你 60×60（mm）—— 每种规格的宽高比都与对应的形状相符</text>
      </view>

      <view class="note">
        形状与打印格式是过滤：不符合的模板会从列表里收起。<text class="note-em">氛围与地区是偏好</text>：符合的排到前面，其余照常显示。
      </view>

      <view class="group">
        <view class="group-head">
          <text class="group-name">氛围</text>
          <text class="tag tag-pref">偏好 · 可多选</text>
        </view>
        <view class="chip-row">
          <view
            class="chip chip-pref {{item.on ? 'chip-on-pref' : ''}}"
            wx:for="{{moods}}"
            wx:key="key"
            data-dim="moods"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="group group-last">
        <view class="group-head">
          <text class="group-name">地区</text>
          <text class="tag tag-pref">偏好 · 可多选</text>
        </view>
        <view class="chip-row">
          <view
            class="chip chip-pref {{item.on ? 'chip-on-pref' : ''}}"
            wx:for="{{regions}}"
            wx:key="key"
            data-dim="regions"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="drawer-foot">
      <view class="btn-ghost" bindtap="resetFilters">重置</view>
      <view class="btn-solid" bindtap="closeDrawer">查看 {{matchCount}} 个模板</view>
    </view>
  </view>
</view>