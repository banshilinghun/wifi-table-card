<view class="page">
  <view class="hero">
    <view class="hero-title">Wi-Fi 桌牌</view>
    <view class="hero-sub">挑一个样式，扫码就能连网</view>
  </view>

  <view class="grid">
    <view
      class="cell"
      wx:for="{{templates}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openEditor"
      hover-class="cell-hover"
      hover-stay-time="80"
    >
      <view class="canvas-box" style="background:{{item.bg}}">
        <canvas
          type="2d"
          class="thumb"
          style="width:{{cardW}}rpx;height:{{cardH}}rpx"
        ></canvas>
      </view>
      <view class="meta">
        <text class="tpl-name">{{item.name}}</text>
        <text class="tpl-tag">{{item.tag}}</text>
      </view>
    </view>
  </view>

  <view class="foot-link" bindtap="goTest">二维码内核自检 ›</view>
  <view class="foot-note">全部数据仅存本机 · 无网络请求 · v{{version}}</view>
</view>
