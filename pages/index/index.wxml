<view class="root">
  <view class="page">
    <view class="masthead">
      <view class="mast-left">
        <text class="mast-kicker">WIFI SIGN</text>
        <view class="mast-title-row">
          <text class="mast-title">桌牌</text>
          <text class="mast-count">{{matchCount}} / {{total}}</text>
        </view>
      </view>
      <view class="mast-right">
        <view class="fav-entry {{favOnly ? 'fav-entry-on' : ''}}" bindtap="toggleFavOnly">
          <text class="fav-heart">{{favOnly ? '♥' : '♡'}}</text>
          <text class="fav-count" wx:if="{{favCount}}">{{favCount}}</text>
        </view>
        <view class="filter-btn {{activeCount ? 'filter-btn-on' : ''}}" bindtap="openDrawer">
          <view class="ico ico-filter">
            <view class="ico-i a"></view>
            <view class="ico-i b"></view>
            <view class="ico-i c"></view>
          </view>
          <text class="filter-txt">筛选</text>
          <view class="filter-badge" wx:if="{{activeCount}}">{{activeCount}}</view>
        </view>
      </view>
    </view>

    <scroll-view class="scenes" scroll-x="true" enable-flex="false" show-scrollbar="false">
      <view
        class="scene {{item.on ? 'scene-on' : ''}}"
        wx:for="{{scenes}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="pickScene"
      >
        <view class="ico ico-{{item.icon}}">
          <view class="ico-i a"></view>
          <view class="ico-i b"></view>
          <view class="ico-i c"></view>
          <view class="ico-i d"></view>
        </view>
        <text class="scene-label">{{item.label}}</text>
      </view>
    </scroll-view>

    <view class="chips-line" wx:if="{{chips.length}}">
      <view
        class="chip chip-sm {{item.kind === 'pref' ? 'chip-pref' : ''}}"
        wx:for="{{chips}}"
        wx:key="key"
        data-dim="{{item.dim}}"
        data-key="{{item.key}}"
        bindtap="toggleChip"
      >
        <text>{{item.label}}</text>
        <text class="chip-x">×</text>
      </view>
      <text class="chips-clear" bindtap="resetFilters">清空</text>
    </view>

    <!-- 缩略图是离屏 canvas 画好后转出来的图片，页面里不再挂 canvas 节点 -->
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="series-head">
        <text class="series-title">{{group.title}}</text>
        <text class="series-count">{{group.items.length}}</text>
      </view>

      <view class="grid">
        <view
          class="cell"
          wx:for="{{group.items}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openEditor"
          hover-class="cell-hover"
          hover-stay-time="60"
        >
          <view class="thumb-box">
            <view
              class="thumb-ph"
              wx:if="{{!item.img}}"
              style="width:{{item.thumbW}}rpx;height:{{item.thumbH}}rpx;background:{{item.tint}}"
            ></view>
            <image
              wx:else
              class="thumb"
              src="{{item.img}}"
              mode="aspectFit"
              style="width:{{item.thumbW}}rpx;height:{{item.thumbH}}rpx"
            />
            <view
              class="cell-fav {{item.fav ? 'cell-fav-on' : ''}}"
              data-id="{{item.id}}"
              catchtap="toggleFav"
            >{{item.fav ? '♥' : '♡'}}</view>
          </view>
          <view class="cell-meta">
            <text class="cell-name">{{item.name}}</text>
            <text class="cell-shape">{{item.shape}}</text>
          </view>
          <text class="cell-prints">{{item.printsText}} · {{item.region}}</text>
        </view>
      </view>
    </block>

    <view class="empty" wx:if="{{!groups.length}}">
      <text class="empty-title">{{favOnly ? '还没有收藏' : '没有符合的模板'}}</text>
      <text class="empty-sub" wx:if="{{favOnly}}">点模板右上角的 ♡ 就能收藏，收藏只存在这台手机上。</text>
      <text class="empty-sub" wx:else>形状与打印尺寸是过滤条件，两者交叉后没有结果。清掉这两项，场景与偏好会保留。</text>
      <view class="empty-btn" wx:if="{{favOnly}}" bindtap="toggleFavOnly">看全部模板</view>
      <view class="empty-btn" wx:else bindtap="clearHardFilters">清除形状/尺寸筛选</view>
      <text class="empty-alt" wx:if="{{!favOnly}}" bindtap="resetFilters">重置全部条件</text>
    </view>

    <view class="foot">
      <view class="privacy" bindtap="showPrivacy">
        <text class="privacy-line">数据只存在这台手机上；导出的图里带着 Wi-Fi 密码</text>
        <text class="privacy-more">隐私说明 ›</text>
      </view>
      <text class="foot-note">v{{version}}</text>
    </view>
  </view>

  <!-- 隐私说明：展开式，不跳页 -->
  <view class="p-mask" wx:if="{{privacy}}" bindtap="closePrivacy" catchtouchmove="noop"></view>
  <view class="p-panel {{privacy ? 'p-panel-on' : ''}}" catchtouchmove="noop">
    <view class="p-head">
      <text class="p-title">隐私说明</text>
      <view class="p-close" bindtap="closePrivacy">×</view>
    </view>
    <scroll-view class="p-body" scroll-y="true" scroll-into-view="{{pInto}}" scroll-with-animation="{{false}}">
      <view class="p-item" wx:for="{{privacyLines}}" wx:key="h">
        <text class="p-h">{{item.h}}</text>
        <text class="p-t">{{item.t}}</text>
      </view>

      <view class="p-data" id="pdata">
        <view class="p-data-row" bindtap="clearDraftData">
          <text class="p-data-name">本机草稿</text>
          <text class="p-data-state">{{draftExists ? '已保存 · 清空' : '暂无'}}</text>
        </view>
        <view class="p-data-row" bindtap="clearWorksData">
          <text class="p-data-name">作品记录</text>
          <text class="p-data-state">{{workCount ? workCount + ' 条 · 删除' : '暂无'}}</text>
        </view>
        <view class="p-data-row" bindtap="openPrivacyContract">
          <text class="p-data-name">用户隐私保护指引</text>
          <text class="p-data-state">查看 ›</text>
        </view>
      </view>
    </scroll-view>
    <view class="p-foot">
      <text class="p-foot-note">生效日期 2026-11-15</text>
      <view class="p-btn" bindtap="closePrivacy">知道了</view>
    </view>
  </view>

  <view class="mask" wx:if="{{drawer}}" bindtap="closeDrawer" catchtouchmove="noop"></view>
  <view class="drawer {{drawer ? 'drawer-on' : ''}}" catchtouchmove="noop">
    <view class="grip"></view>

    <view class="drawer-head">
      <text class="drawer-title">筛选</text>
      <view class="drawer-close" bindtap="closeDrawer">
        <view class="ico ico-close">
          <view class="ico-i a"></view>
          <view class="ico-i b"></view>
        </view>
      </view>
    </view>

    <scroll-view class="drawer-body" scroll-y="true" enhanced="true" show-scrollbar="false" bounces="false">
      <view class="group">
        <view class="group-head">
          <text class="group-name">形状</text>
          <text class="tag tag-filter">过滤</text>
        </view>
        <view class="chip-row">
          <view
            class="chip {{item.on ? 'chip-on' : ''}}"
            wx:for="{{shapes}}"
            wx:key="key"
            data-dim="shapes"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="group">
        <view class="group-head">
          <text class="group-name">打印格式</text>
          <text class="tag tag-filter">过滤</text>
        </view>
        <view class="chip-row">
          <view
            class="chip {{item.on ? 'chip-on' : ''}}"
            wx:for="{{printOpts}}"
            wx:key="key"
            data-dim="prints"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
        <text class="group-note">A6 小卡 105×148 · A5 · A4 · 横版 A5 · 长条 200×100 · 竖条 100×200 · 迷你 60×60（mm）—— 每种规格的宽高比都与对应的形状相符</text>
      </view>

      <view class="note">
        形状与打印格式是过滤：不符合的模板会从列表里收起。<text class="note-em">氛围与地区是偏好</text>：符合的排到前面，其余照常显示。
      </view>

      <view class="group">
        <view class="group-head">
          <text class="group-name">氛围</text>
          <text class="tag tag-pref">偏好 · 可多选</text>
        </view>
        <view class="chip-row">
          <view
            class="chip chip-pref {{item.on ? 'chip-on-pref' : ''}}"
            wx:for="{{moods}}"
            wx:key="key"
            data-dim="moods"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="group group-last">
        <view class="group-head">
          <text class="group-name">地区</text>
          <text class="tag tag-pref">偏好 · 可多选</text>
        </view>
        <view class="chip-row">
          <view
            class="chip chip-pref {{item.on ? 'chip-on-pref' : ''}}"
            wx:for="{{regions}}"
            wx:key="key"
            data-dim="regions"
            data-key="{{item.key}}"
            bindtap="toggleChip"
          >{{item.label}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="drawer-foot">
      <view class="btn-ghost" bindtap="resetFilters">重置</view>
      <view class="btn-solid" bindtap="closeDrawer">查看 {{matchCount}} 个模板</view>
    </view>
  </view>
</view>
