.hero {
  padding: 40rpx 8rpx 44rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 12rpx 32rpx;
}

.cell-hover {
  opacity: 0.82;
}

.canvas-box {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(42, 39, 36, 0.09);
}

.thumb {
  display: block;
}

.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 4rpx 0;
}

.tpl-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.tpl-tag {
  font-size: 21rpx;
  color: #a29a8d;
}

.foot-link {
  margin-top: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--accent);
  border-top: 1rpx solid var(--line);
}

.foot-note {
  padding-bottom: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b3ab9e;
}
